	partition 'Credit Applications' = m
		mode: import
		source =
				let
				    // Reads the table exported from the gold layer (one Parquet file per table)
				    Source = Parquet.Document(File.Contents(DataFolder & "fact_application_scored.parquet")),
				    // Explicit data types, so the model never depends on type detection
				    Typed = Table.TransformColumnTypes(Source, {{"application_id", Int64.Type}, {"defaulted", Int64.Type}, {"sample", type text}, {"credit_score", type number}, {"probability_of_default", type number}, {"risk_grade", type text}, {"contract_type", type text}, {"gender", type text}, {"income_type", type text}, {"housing_type", type text}, {"occupation", type text}, {"region_rating", Int64.Type}, {"credit_amount", type number}, {"annual_income", type number}, {"annual_payment", type number}, {"payment_to_income", type number}, {"credit_to_income", type number}, {"age_years", type number}, {"employment_not_reported", type logical}, {"bureau_credits", Int64.Type}, {"bureau_overdue_credits", Int64.Type}, {"previous_applications", Int64.Type}, {"previous_refused", Int64.Type}, {"installments_due", Int64.Type}, {"late_installment_share", type number}, {"education_key", Int64.Type}, {"age_band_key", Int64.Type}, {"income_band_key", Int64.Type}, {"payment_burden_key", Int64.Type}, {"payment_behavior_key", Int64.Type}, {"bureau_status_key", Int64.Type}, {"previous_refusals_key", Int64.Type}})
				in
				    Typed

	annotation PBI_ResultType = Table

