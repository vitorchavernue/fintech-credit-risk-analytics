/// One row per loan application: outcome, credit score, risk grade and segment keys.
table 'Credit Applications'
	lineageTag: a4588837-e5e7-4cf8-acaa-d19db809a7ba

	/// Number of loan applications.
	measure Applications = COUNTROWS ( 'Credit Applications' )
		formatString: #,0
		displayFolder: 1. Portfolio
		lineageTag: 2f137305-99b1-483f-87dc-f30a4ed66247

	/// Customers who defaulted (had payment difficulties).
	measure Defaults = SUM ( 'Credit Applications'[Defaulted] )
		formatString: #,0
		displayFolder: 1. Portfolio
		lineageTag: d9446541-503b-464a-9844-e35b5ed47583

	/// Share of customers who defaulted.
	measure 'Default Rate' = DIVIDE ( [Defaults], [Applications] )
		formatString: 0.00%
		displayFolder: 1. Portfolio
		lineageTag: f7a47ce3-2781-451f-a952-4c93ff9feff2

	/// Default rate of the whole portfolio, ignoring every filter (reference line).
	measure 'Portfolio Default Rate' = CALCULATE ( [Default Rate], REMOVEFILTERS ( 'Credit Applications' ) )
		formatString: 0.00%
		displayFolder: 1. Portfolio
		lineageTag: 30d196ee-3ed1-4c30-83c9-0414bd67a479

	/// Default rate compared with the portfolio average.
	measure 'Risk Index' =
			-- 1.0 = average risk; 2.0 = twice the portfolio default rate
			DIVIDE ( [Default Rate], [Portfolio Default Rate] )
		formatString: 0.00"x"
		displayFolder: 1. Portfolio
		lineageTag: 0ebb96f3-b77c-4e87-9e1a-8cb56a7058af

	/// Lower limit of the 95% confidence interval of the default rate.
	measure 'Default Rate CI Low' =
			-- Wilson 95% confidence interval: reliable even for small segments
			VAR n = [Applications]
			VAR p = [Default Rate]
			VAR z = 1.96
			VAR centre = ( p + z ^ 2 / ( 2 * n ) ) / ( 1 + z ^ 2 / n )
			VAR margin = z * SQRT ( p * ( 1 - p ) / n + z ^ 2 / ( 4 * n ^ 2 ) ) / ( 1 + z ^ 2 / n )
			RETURN IF ( n > 0, MAX ( 0, centre - margin ) )
		formatString: 0.00%
		displayFolder: 1. Portfolio
		lineageTag: 04cec971-2be2-4f97-b977-0b0da974feda

	/// Upper limit of the 95% confidence interval of the default rate.
	measure 'Default Rate CI High' =
			-- Wilson 95% confidence interval: reliable even for small segments
			VAR n = [Applications]
			VAR p = [Default Rate]
			VAR z = 1.96
			VAR centre = ( p + z ^ 2 / ( 2 * n ) ) / ( 1 + z ^ 2 / n )
			VAR margin = z * SQRT ( p * ( 1 - p ) / n + z ^ 2 / ( 4 * n ^ 2 ) ) / ( 1 + z ^ 2 / n )
			RETURN IF ( n > 0, MIN ( 1, centre + margin ) )
		formatString: 0.00%
		displayFolder: 1. Portfolio
		lineageTag: 1d244a73-8669-4c22-865e-fa2f3454cf91

	/// Total amount lent.
	measure 'Total Credit Amount' = SUM ( 'Credit Applications'[Credit Amount] )
		formatString: #,0
		displayFolder: 1. Portfolio
		lineageTag: a3954d8c-0bb4-41cc-a349-83039ac3917f

	/// Loan amount of defaulted customers times the loss given default.
	measure 'Estimated Loss' =
			-- money lost on loans that defaulted: loan amount x loss given default
			SUMX ( 'Credit Applications', 'Credit Applications'[Credit Amount] * 'Credit Applications'[Defaulted] ) * [Loss Given Default Value]
		formatString: #,0
		displayFolder: 1. Portfolio
		lineageTag: 0b1b4ee7-50e4-431d-a5d7-f99f8b628019

	/// Average credit score (higher = safer).
	measure 'Average Score' = AVERAGE ( 'Credit Applications'[Credit Score] )
		formatString: 0
		displayFolder: 2. Credit Score
		lineageTag: 82052514-b699-483e-b6b0-73dccabe4252

	/// Default rate predicted by the model; compare with the real Default Rate to check calibration.
	measure 'Average Probability of Default' = AVERAGE ( 'Credit Applications'[Probability of Default] )
		formatString: 0.00%
		displayFolder: 2. Credit Score
		lineageTag: 8256f540-b0d7-450f-9700-9b5d5f865d2c

	/// Customers kept aside to measure the model (never seen in training).
	measure 'Test Applications' = CALCULATE ( [Applications], 'Credit Applications'[Sample] = "test" )
		formatString: #,0
		displayFolder: 2. Credit Score
		lineageTag: ea000f9e-2dff-46e8-a72a-a8ffb6929901

	/// Share of customers approved at the selected cutoff.
	measure 'Approval Rate (Cutoff)' =
			-- share of unseen customers with a score at or above the selected cutoff
			VAR Cutoff = [Cutoff Score Value]
			VAR Tested = CALCULATE ( [Applications], 'Credit Applications'[Sample] = "test" )
			VAR Approved = CALCULATE ( [Applications], 'Credit Applications'[Sample] = "test", 'Credit Applications'[Credit Score] >= Cutoff )
			RETURN DIVIDE ( Approved, Tested )
		formatString: 0.0%
		displayFolder: 3. Credit Policy
		lineageTag: 3b19bffc-038e-4a6e-9897-e7ebf61bf54f

	/// Default rate of the customers approved at the selected cutoff.
	measure 'Default Rate Approved (Cutoff)' =
			VAR Cutoff = [Cutoff Score Value]
			RETURN CALCULATE ( [Default Rate], 'Credit Applications'[Sample] = "test", 'Credit Applications'[Credit Score] >= Cutoff )
		formatString: 0.00%
		displayFolder: 3. Credit Policy
		lineageTag: 929e31f4-7ba3-433b-8558-fcabb69e1f6c

	/// Share of defaults avoided by rejecting scores below the cutoff.
	measure 'Defaults Avoided % (Cutoff)' =
			-- share of all bad customers that the cutoff rejects
			VAR Cutoff = [Cutoff Score Value]
			VAR Rejected = CALCULATE ( [Defaults], 'Credit Applications'[Sample] = "test", 'Credit Applications'[Credit Score] < Cutoff )
			RETURN DIVIDE ( Rejected, CALCULATE ( [Defaults], 'Credit Applications'[Sample] = "test" ) )
		formatString: 0.0%
		displayFolder: 3. Credit Policy
		lineageTag: 357d5dd8-13bc-4d59-b502-06defb4ada94

	/// Customers who would have paid but are rejected by the cutoff.
	measure 'Good Customers Rejected (Cutoff)' =
			VAR Cutoff = [Cutoff Score Value]
			RETURN CALCULATE ( [Applications], 'Credit Applications'[Sample] = "test", 'Credit Applications'[Credit Score] < Cutoff, 'Credit Applications'[Defaulted] = 0 )
		formatString: #,0
		displayFolder: 3. Credit Policy
		lineageTag: ccfab419-5874-4d09-a932-ba956585e9c0

	/// Money not lost because bad customers below the cutoff are rejected.
	measure 'Loss Avoided (Cutoff)' =
			-- loans of rejected bad customers x loss given default
			VAR Cutoff = [Cutoff Score Value]
			RETURN
			    CALCULATE ( SUMX ( 'Credit Applications', 'Credit Applications'[Credit Amount] * 'Credit Applications'[Defaulted] ), 'Credit Applications'[Sample] = "test", 'Credit Applications'[Credit Score] < Cutoff )
			        * [Loss Given Default Value]
		formatString: #,0
		displayFolder: 3. Credit Policy
		lineageTag: 2849bdb5-cc89-4522-885a-6a17e1927f11

	/// Profit not earned from good customers rejected by the cutoff.
	measure 'Margin Lost (Cutoff)' =
			-- loans of rejected good customers x net margin
			VAR Cutoff = [Cutoff Score Value]
			RETURN
			    CALCULATE ( [Total Credit Amount], 'Credit Applications'[Sample] = "test", 'Credit Applications'[Credit Score] < Cutoff, 'Credit Applications'[Defaulted] = 0 )
			        * [Net Margin Value]
		formatString: #,0
		displayFolder: 3. Credit Policy
		lineageTag: 3edc50b4-1b11-4715-8f45-3337a16af75c

	/// Loss avoided minus margin lost, compared with approving everybody.
	measure 'Net Benefit (Cutoff)' = [Loss Avoided (Cutoff)] - [Margin Lost (Cutoff)]
		formatString: #,0
		displayFolder: 3. Credit Policy
		lineageTag: 6d42afbd-4b3f-4ba1-a4ec-0de0901a3595

