/// Approval rate, defaults avoided and net benefit for each cutoff.
table 'Cutoff Simulation'
	lineageTag: 82b84826-0023-4207-b531-c08dfa312ae6

	/// Minimum score with the highest net benefit in the pipeline simulation.
	measure 'Recommended Cutoff' = CALCULATE ( MAX ( 'Cutoff Simulation'[Minimum Score] ), 'Cutoff Simulation'[Recommended] = TRUE () )
		formatString: 0
		displayFolder: Measures
		lineageTag: 695a9bd3-8a7f-4341-b912-3544543edd9e

	column 'Target Approval Rate'
		dataType: double
		formatString: 0.0%
		lineageTag: 5ba3dc24-97b4-4d26-a637-a0064151fbcb
		summarizeBy: none
		sourceColumn: target_approval_rate

		annotation SummarizationSetBy = Automatic

	column 'Minimum Score'
		dataType: double
		formatString: 0
		lineageTag: 0ae28448-8bc3-434d-bb44-e07010a2bf6b
		summarizeBy: none
		sourceColumn: minimum_score

		annotation SummarizationSetBy = Automatic

	column Approved
