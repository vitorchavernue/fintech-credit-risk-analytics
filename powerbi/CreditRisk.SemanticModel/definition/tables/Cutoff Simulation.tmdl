		annotation SummarizationSetBy = Automatic

	partition 'Cutoff Simulation' = m
		mode: import
		source =
				let
				    // Reads the table exported from the gold layer (one Parquet file per table)
				    Source = Parquet.Document(File.Contents(DataFolder & "policy_cutoff_simulation.parquet")),
				    // Explicit data types, so the model never depends on type detection
				    Typed = Table.TransformColumnTypes(Source, {{"target_approval_rate", type number}, {"minimum_score", type number}, {"approved", Int64.Type}, {"approval_rate", type number}, {"default_rate_approved", type number}, {"default_rate_rejected", type number}, {"defaults_avoided", Int64.Type}, {"share_of_defaults_avoided", type number}, {"good_customers_rejected", Int64.Type}, {"credit_approved", type number}, {"loss_avoided", type number}, {"margin_lost", type number}, {"net_benefit", type number}, {"recommended", type logical}})
				in
				    Typed

	annotation PBI_ResultType = Table

