	/// Characteristic name in plain words (payment behavior, bureau status...).
	column Characteristic = SUBSTITUTE ( 'Characteristic Tests'[Dimension], "_", " " )
		dataType: string
		lineageTag: fb6daee6-f799-4aa7-b7e1-c0b797c0308d
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition 'Characteristic Tests' = m
		mode: import
		source =
				let
				    // Reads the table exported from the gold layer (one Parquet file per table)
				    Source = Parquet.Document(File.Contents(DataFolder & "stats_dimension_tests.parquet")),
				    // Explicit data types, so the model never depends on type detection
				    Typed = Table.TransformColumnTypes(Source, {{"dimension", type text}, {"segments", Int64.Type}, {"information_value", type number}, {"predictive_power", type text}, {"chi_square", type number}, {"degrees_of_freedom", Int64.Type}, {"p_value", type number}, {"cramers_v", type number}, {"significant", type logical}, {"use", type text}})
				in
				    Typed

	annotation PBI_ResultType = Table

