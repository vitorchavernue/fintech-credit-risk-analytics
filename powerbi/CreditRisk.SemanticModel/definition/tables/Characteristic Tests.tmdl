/// Information Value, chi-square and Cramér's V per characteristic.
table 'Characteristic Tests'
	lineageTag: f38a40ec-a862-4cc0-a0a9-b7e494dea6a2

	column Dimension
		dataType: string
		lineageTag: 0e73229d-9a0f-4cf6-81a0-3d58f66a2955
		summarizeBy: none
		sourceColumn: dimension

		annotation SummarizationSetBy = Automatic

	column Segments
		dataType: int64
		formatString: 0
		lineageTag: 8d538233-26b6-439c-a454-2b1524c6192b
